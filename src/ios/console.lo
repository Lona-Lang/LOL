import diagnostic/fatal
import ios/_c
import ios/file
import ios/stream

def standard_input() file.File {
    ret file._borrow(_c.stdin)
}

def standard_output() file.File {
    ret file._borrow(_c.stdout)
}

def standard_error() file.File {
    ret file._borrow(_c.stderr)
}

def write(text u8 const[*]) {
    var target = standard_output()
    var status = stream.write_to[file.File](ref target, text)
    if status.failed() {
        fatal.panic("ios.console.write: write failed")
    }
}

def write_line(text u8 const[*]) {
    var target = standard_output()
    var status = stream.write_line_to[file.File](ref target, text)
    if status.failed() {
        fatal.panic("ios.console.write_line: write failed")
    }
}

def error(text u8 const[*]) {
    var target = standard_error()
    var status = stream.write_to[file.File](ref target, text)
    if status.failed() {
        fatal.panic("ios.console.error: write failed")
    }
}

def error_line(text u8 const[*]) {
    var target = standard_error()
    var status = stream.write_line_to[file.File](ref target, text)
    if status.failed() {
        fatal.panic("ios.console.error_line: write failed")
    }
}

def flush() {
    var target = standard_output()
    var status = stream.flush[file.File](ref target)
    if status.failed() {
        fatal.panic("ios.console.flush: flush failed")
    }
}

def flush_error() {
    var target = standard_error()
    var status = stream.flush[file.File](ref target)
    if status.failed() {
        fatal.panic("ios.console.flush_error: flush failed")
    }
}
