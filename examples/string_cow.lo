import string/string
import string/view

var created = string.from_literal("lona")
if created.failed() {
    ret created.code()
}

var left = created.value
var right = left.share()

var status = left.append(view.from_literal("-lang"))
if status.failed() {
    right.release()
    left.release()
    ret status.code
}

if !left.equals(view.from_literal("lona-lang")) {
    right.release()
    left.release()
    ret 10
}

if !right.equals(view.from_literal("lona")) {
    right.release()
    left.release()
    ret 11
}

status = right.prepend(view.from_literal("my-"))
if status.failed() {
    right.release()
    left.release()
    ret status.code
}

if !right.equals(view.from_literal("my-lona")) {
    right.release()
    left.release()
    ret 12
}

if !left.equals(view.from_literal("lona-lang")) {
    right.release()
    left.release()
    ret 13
}

right.release()
left.release()
ret 0
