import string/string
import string/view

var left = string.from_literal("lona")
var right = left.share()

left.append(view.from_literal("-lang"))
if !left.equals(view.from_literal("lona-lang")) {
    right.release()
    left.release()
    ret 10
}

if !right.equals(view.from_literal("lona")) {
    right.release()
    left.release()
    ret 11
}

right.prepend(view.from_literal("my-"))
if !right.equals(view.from_literal("my-lona")) {
    right.release()
    left.release()
    ret 12
}

if !left.equals(view.from_literal("lona-lang")) {
    right.release()
    left.release()
    ret 13
}

right.release()
left.release()
ret 0
