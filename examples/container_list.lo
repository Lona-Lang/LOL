import container/list

var values = list.make[i32]()
values.push_back(5)
values.push_back(6)
values.push_front(4)

var it = values.iter()
var total i32 = 0
for !it.done() {
    var item = it.value()
    if item == null {
        values.clear()
        ret 10
    }

    total = total + *item
    it.next()
}

if total != 15 {
    values.clear()
    ret 11
}

var first i32 = 0
values.pop_front(ref first)

if first != 4 {
    values.clear()
    ret 12
}

values.clear()
ret 0
