import algorithm/order
import algorithm/search
import algorithm/sort
import container/vec

var values = vec.make[i32]()
values.reserve(6)
values.push(7)
values.push(2)
values.push(9)
values.push(1)
values.push(5)
values.push(2)

sort.sort_vec_by[i32](ref values, @order.compare_i32)
if !sort.is_sorted_by[i32](values.data, values.size, @order.compare_i32) {
    values.release()
    ret 10
}

var target i32 = 5
var found = search.binary_search_vec_by[i32](values, &target, @order.compare_i32)
if found.failed() {
    values.release()
    ret 11
}

if found.value != 3 {
    values.release()
    ret 12
}

sort.reverse[i32](values.data, values.size)
if values.data(0) != 9 {
    values.release()
    ret 13
}

values.release()
ret 0
