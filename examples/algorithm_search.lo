import algorithm/order
import algorithm/search
import container/slice

def equal_i32(left i32 const*, right i32 const*) bool {
    ret *left == *right
}

var raw i32[6] = {1, 3, 3, 5, 8, 13}
var items = slice.from_ptr[i32](cast[i32 const[*]](&raw(0)), 6)
var target i32 = 3

var first = search.index_of_by[i32](items, &target, @equal_i32)
if first.failed() {
    ret 10
}

if first.value != 1 {
    ret 11
}

if !search.contains_by[i32](items, &target, @equal_i32) {
    ret 12
}

var lower = search.lower_bound_by[i32](items, &target, @order.compare_i32)
if lower != 1 {
    ret 13
}

var upper = search.upper_bound_by[i32](items, &target, @order.compare_i32)
if upper != 3 {
    ret 14
}

var missing i32 = 4
var absent = search.binary_search_by[i32](items, &missing, @order.compare_i32)
if !absent.missing() {
    ret 15
}

ret 0
