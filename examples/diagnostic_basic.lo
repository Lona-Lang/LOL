import diagnostic/diagnostic

var status = diagnostic.note("starting diagnostic demo")
if status.failed() {
    ret status.code
}

status = diagnostic.warn("this is only a warning")
if status.failed() {
    ret status.code
}

status = diagnostic.error_if(true, "this is a recoverable error report")
if status.failed() {
    ret status.code
}

if diagnostic.require(true, "unreachable requirement failure") != 0 {
    ret 10
}

ret 0
