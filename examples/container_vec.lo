import container/vec

var values = vec.make[i32]()
values.push(10)
values.push(20)
values.push(30)

if values.len() != 3 {
    values.release()
    ret 10
}

var view = values.view()
var middle = view.at(1)
if middle == null {
    values.release()
    ret 11
}

if *middle != 20 {
    values.release()
    ret 12
}

var last i32 = 0
values.pop(ref last)

if last != 30 {
    values.release()
    ret 13
}

values.release()
ret 0
